{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nemoir.dev/schema/trace/0.1/public-event.schema.json",
  "title": "NemoTrace 0.1 public ledger writer record",
  "$defs": {
    "public_scalar": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"$ref": "common.schema.json#/$defs/redaction_marker"}
      ]
    },
    "public_args": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "pattern": "^\\$", "maxLength": 512},
        "path_ref": {"type": "string", "pattern": "^path-[1-9][0-9]*$"},
        "root_class": {"type": "string", "pattern": "^\\$[a-z][a-z0-9_]*$"},
        "content": {"$ref": "common.schema.json#/$defs/redaction_marker"},
        "command_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 128},
        "method": {"type": "string", "pattern": "^[A-Z]+$", "maxLength": 16},
        "origin_class": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 128},
        "key": {"$ref": "common.schema.json#/$defs/redaction_marker"},
        "value": {"$ref": "common.schema.json#/$defs/redaction_marker"},
        "code": {"$ref": "common.schema.json#/$defs/redaction_marker"},
        "input": {"$ref": "common.schema.json#/$defs/redaction_marker"},
        "headers": {"$ref": "common.schema.json#/$defs/redaction_marker"},
        "body": {"$ref": "common.schema.json#/$defs/redaction_marker"},
        "question": {"$ref": "common.schema.json#/$defs/redaction_marker"},
        "message": {"$ref": "common.schema.json#/$defs/redaction_marker"},
        "options": {"$ref": "common.schema.json#/$defs/redaction_marker"}
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "workflow_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "entry": {"type": "string", "minLength": 1, "maxLength": 256},
        "response_bytes": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0},
        "attempt": {"type": "integer", "minimum": 1},
        "max_retries": {"type": "integer", "minimum": 0},
        "category": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
        "duration_ms": {"type": "integer", "minimum": 0},
        "result_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
        "result_status": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
        "policy_ref": {"type": "string", "pattern": "^p-[1-9][0-9]*$"},
        "policy_kind": {"enum": ["before", "deny"]},
        "denied": {"type": "boolean"},
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "reason": {
          "enum": [
            "explicit_transition",
            "backward_ref_loop",
            "next_stage_required_input_available",
            "skip_next_stage_required_input_missing",
            "fallthrough",
            "other"
          ]
        },
        "priority": {"type": "integer", "minimum": 0},
        "step_count": {"type": "integer", "minimum": 0},
        "error_type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "maxLength": 128},
        "error_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
        "content_omitted": {"type": "boolean"},
        "root_class": {"type": "string", "pattern": "^\\$[a-z][a-z0-9_]*$"},
        "path_ref": {"type": "string", "pattern": "^path-[1-9][0-9]*$"},
        "byte_count": {"type": "integer", "minimum": 0},
        "command_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 128},
        "exit_class": {"enum": ["success", "failure", "signal", "timeout"]},
        "method": {"type": "string", "pattern": "^[A-Z]+$", "maxLength": 16},
        "origin_class": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 128},
        "status_class": {"type": "string", "pattern": "^[1-5]xx$"},
        "value_type": {"enum": ["string", "number", "boolean", "object", "array", "null", "binary"]},
        "code_bytes": {"type": "integer", "minimum": 0},
        "input_bytes": {"type": "integer", "minimum": 0},
        "approval": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["kind", "run_id", "timestamp", "redacted_fields"],
  "properties": {
    "kind": {
      "enum": [
        "run_started",
        "stage_started",
        "model_delta",
        "model_completed",
        "model_retry",
        "tool_call_started",
        "tool_call_completed",
        "tool_call_failed",
        "policy_checked",
        "policy_denied",
        "transition_selected",
        "stage_completed",
        "run_completed",
        "run_failed",
        "annotation"
      ]
    },
    "run_id": {"$ref": "common.schema.json#/$defs/trace_id"},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"$ref": "common.schema.json#/$defs/timestamp"},
    "stage_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "stage_visit_id": {"$ref": "common.schema.json#/$defs/stage_visit_id"},
    "model_call_id": {"$ref": "common.schema.json#/$defs/model_call_id"},
    "tool_call_id": {"$ref": "common.schema.json#/$defs/tool_call_id"},
    "channel": {
      "oneOf": [
        {"enum": ["assistant", "progress", "reasoning", "reasoning_summary", "debug"]},
        {"type": "null"}
      ]
    },
    "text": {"$ref": "common.schema.json#/$defs/redaction_marker"},
    "capability": {"type": "string", "minLength": 1, "maxLength": 128},
    "tool_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 128},
    "args": {"$ref": "#/$defs/public_args"},
    "output": {
      "type": "object",
      "maxProperties": 256,
      "additionalProperties": {"$ref": "#/$defs/public_scalar"}
    },
    "result": {"$ref": "common.schema.json#/$defs/redaction_marker"},
    "error": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
    "transition_to": {"type": "string", "minLength": 1, "maxLength": 256},
    "metadata": {"$ref": "#/$defs/metadata"},
    "redacted_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
        "maxLength": 512
      }
    },
    "anchor_sequence": {"type": "integer", "minimum": 1},
    "annotation": {
      "type": "object",
      "required": ["namespace", "kind", "payload"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1, "maxLength": 128},
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "payload": {
          "oneOf": [
            {"type": "object", "maxProperties": 128, "additionalProperties": {"$ref": "common.schema.json#/$defs/json_value"}},
            {"$ref": "common.schema.json#/$defs/redaction_marker"}
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "annotation"}}, "required": ["kind"]},
      "then": {
        "required": ["annotation"],
        "not": {"required": ["sequence"]}
      },
      "else": {"required": ["sequence"]}
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "stage_started",
              "model_delta",
              "model_completed",
              "model_retry",
              "tool_call_started",
              "tool_call_completed",
              "tool_call_failed",
              "policy_checked",
              "policy_denied",
              "transition_selected",
              "stage_completed"
            ]
          }
        },
        "required": ["kind"]
      },
      "then": {"required": ["stage_id", "stage_visit_id"]}
    },
    {
      "if": {
        "properties": {"kind": {"enum": ["model_delta", "model_completed", "model_retry"]}},
        "required": ["kind"]
      },
      "then": {"required": ["model_call_id"]}
    },
    {
      "if": {
        "properties": {"kind": {"enum": ["tool_call_started", "tool_call_completed", "tool_call_failed"]}},
        "required": ["kind"]
      },
      "then": {"required": ["tool_call_id", "capability"]}
    },
    {
      "if": {"properties": {"kind": {"const": "transition_selected"}}, "required": ["kind"]},
      "then": {"required": ["transition_to"]}
    },
    {
      "if": {"required": ["text"]},
      "then": {"properties": {"kind": {"const": "model_delta"}}}
    },
    {
      "if": {"required": ["args"]},
      "then": {"properties": {"kind": {"const": "tool_call_started"}}}
    },
    {
      "if": {"required": ["output"]},
      "then": {"properties": {"kind": {"const": "stage_completed"}}}
    },
    {
      "if": {"required": ["result"]},
      "then": {"properties": {"kind": {"const": "run_completed"}}}
    },
    {
      "if": {"required": ["annotation"]},
      "then": {"properties": {"kind": {"const": "annotation"}}}
    },
    {
      "if": {"required": ["anchor_sequence"]},
      "then": {"properties": {"kind": {"const": "annotation"}}}
    },
    {
      "if": {"required": ["channel"]},
      "then": {"properties": {"kind": {"const": "model_delta"}}}
    },
    {
      "if": {"required": ["model_call_id"]},
      "then": {
        "properties": {
          "kind": {"enum": ["model_delta", "model_completed", "model_retry"]}
        }
      }
    },
    {
      "if": {"required": ["tool_call_id"]},
      "then": {
        "properties": {
          "kind": {"enum": ["tool_call_started", "tool_call_completed", "tool_call_failed"]}
        }
      }
    },
    {
      "if": {"required": ["tool_name"]},
      "then": {
        "properties": {
          "kind": {"enum": ["tool_call_started", "tool_call_completed", "tool_call_failed"]}
        }
      }
    },
    {
      "if": {"required": ["capability"]},
      "then": {
        "properties": {
          "kind": {
            "enum": [
              "tool_call_started",
              "tool_call_completed",
              "tool_call_failed",
              "policy_checked",
              "policy_denied"
            ]
          }
        }
      }
    },
    {
      "if": {"required": ["transition_to"]},
      "then": {"properties": {"kind": {"const": "transition_selected"}}}
    },
    {
      "if": {"required": ["error"]},
      "then": {
        "properties": {
          "kind": {"enum": ["model_retry", "tool_call_failed", "policy_denied", "run_failed"]}
        }
      }
    }
  ],
  "additionalProperties": false
}
